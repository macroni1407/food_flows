# docker-compose.yml injects these into every Airflow container.

# Snowflake. SNOWFLAKE_ACCOUNT looks like: ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# LLM used by the enrich_reviews task
GROQ_API_KEY=

# Reviews enriched per DAG run (optional, defaults to 5)
SAMPLE_N=5
