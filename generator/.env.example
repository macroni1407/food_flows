# Access key of the IAM user that may only write to s3://<BUCKET>/raw/*
# (policy: aws/iam/generator-s3-write-policy.json).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Bucket that the Snowflake stage reads from, and the folder prefix used by the stage
S3_BUCKET=
S3_PREFIX=raw

# Optional generator settings
GENERATOR_ORDERS_PER_DAY=25000
GENERATOR_START_DATE=2026-09-01
